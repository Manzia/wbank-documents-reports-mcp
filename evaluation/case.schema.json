{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Manzia/wbank-documents-reports-mcp/evaluation/case.schema.json",
  "title": "Evaluation case",
  "description": "One expected query (context/design/wbank-mcp-query-design.md) turned into a test case (design §10.1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "query_id", "group", "tier", "task", "query_wording", "turns", "expected_sources", "reference_answer", "rubric", "stability"],
  "properties": {
    "id": { "type": "string", "pattern": "^Q[1-4]-[0-9]{2}$", "description": "Case ID; also the file name stem." },
    "query_id": { "type": "string", "pattern": "^Q[1-4]\\.[0-9]{1,2}$", "description": "Group and row number of the query in the expected-queries doc." },
    "group": { "enum": ["Q1", "Q2", "Q3", "Q4"] },
    "tier": { "enum": ["search_and_retrieve", "project_centred_reading", "cross_project_synthesis"], "description": "Design §9 tier." },
    "task": { "type": "string", "minLength": 1, "description": "The query's task label, e.g. 'Assess implementation'." },
    "query_wording": { "type": "string", "minLength": 1, "description": "The query exactly as worded in the expected-queries doc, placeholders included." },
    "placeholders": {
      "type": "array",
      "description": "Each placeholder (explicit or implied) and what it was replaced with.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["placeholder", "resolved_to", "reason"],
        "properties": {
          "placeholder": { "type": "string", "minLength": 1 },
          "resolved_to": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "description": "User messages, in order. The agent sees only these.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user"],
        "properties": { "user": { "type": "string", "minLength": 1 } }
      }
    },
    "expected_sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "reference_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review", "as_of", "turns"],
      "properties": {
        "review": { "enum": ["pending", "done"], "description": "Set to 'done' by the reviewer after checking the answer against the sources." },
        "as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Date the sources were read." },
        "turns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["turn", "text"],
            "properties": {
              "turn": { "type": "integer", "minimum": 1 },
              "text": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["right_sources", "grounded", "complete", "scoped"],
      "description": "Design §10.2: the case passes only if every part passes.",
      "properties": {
        "right_sources": { "$ref": "#/$defs/criteria" },
        "grounded": { "$ref": "#/$defs/criteria" },
        "complete": { "$ref": "#/$defs/criteria" },
        "scoped": { "$ref": "#/$defs/criteria" }
      }
    },
    "stability": {
      "enum": ["stable", "may_change"],
      "description": "'may_change' when newer disclosures (a new ISR, plan or report) can change the correct answer after as_of."
    },
    "notes": { "type": "string", "minLength": 1, "description": "For the reviewer and the judge; not shown to the agent." }
  },
  "$defs": {
    "criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "role"],
      "properties": {
        "kind": { "enum": ["project", "document", "search"] },
        "role": { "type": "string", "minLength": 1, "description": "Why the source is expected, e.g. 'latest disclosed ISR'." },
        "required": { "type": "boolean", "description": "false: one acceptable source among alternatives. Default true." },
        "turn": { "type": "integer", "minimum": 1, "description": "The turn that needs it; omitted for all turns." },
        "project_id": { "type": "string", "pattern": "^P[0-9]{6}$" },
        "document_id": { "type": "string", "pattern": "^[0-9]+$", "description": "WDS record ID." },
        "report_number": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "document_type": { "type": "string", "minLength": 1 },
        "document_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "pages": { "type": "string", "pattern": "^[0-9]+(-[0-9]+)?(, ?[0-9]+(-[0-9]+)?)*$", "description": "PDF page numbers (the text file's form-feed pages)." },
        "api": { "enum": ["wds", "projects"], "description": "For kind 'search': which API." },
        "filters": {
          "type": "object",
          "description": "For kind 'search': the API parameters a correct search uses (WDS or Projects API names).",
          "additionalProperties": { "type": "string" }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
